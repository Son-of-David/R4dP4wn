[Unit]
Description=P4wnP1 A.L.O.A.
After=local-fs.target systemd-modules-load.service systemd-udevd.service network-pre.target
Wants=network-pre.target
DefaultDependencies=yes

[Service]
Type=simple
ExecStart=/usr/local/bin/P4wnP1_service
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
